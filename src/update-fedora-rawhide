#!/usr/bin/env python3
"""Ícone de bandeja que vigia atualizações do Fedora Rawhide.

Verde = em dia. Vermelho = há atualizações. Cinza = checando ou aplicando.
Checa a cada 10 minutos por padrão, e o menu tem "Check now".

Detalhes de projeto:

- A checagem roda `dnf check-update` num processo separado e SEM sudo, porque
  ela é somente-leitura. Só o "Install updates" pede senha, via pkexec.

- Rawhide troca de kernel quase todo dia, e kernel novo significa que o módulo
  da NVIDIA precisa recompilar. Por isso o menu separa quantos dos pendentes
  são de kernel/nvidia: é a informação que decide se vai precisar reiniciar.

- Nada de bloquear a interface. Toda chamada externa acontece numa thread e o
  resultado volta pro loop do GTK com GLib.idle_add.

- A interface é em inglês; os comentários, em português.
"""
import os
import re
import shlex
import subprocess
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AppIndicator3", "0.1")
gi.require_version("Notify", "0.7")
from gi.repository import AppIndicator3, GLib, Gtk, Notify  # noqa: E402

APP_ID = "update-fedora-rawhide"
HOME = os.path.expanduser("~")
AUTOSTART = os.path.join(HOME, ".config/autostart", f"{APP_ID}.desktop")
SELF = os.path.abspath(__file__)

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), APP_ID)
CONFIG = os.path.join(CONFIG_DIR, "colors.conf")

# Os ícones são instalados no tema hicolor do sistema
# (/usr/share/icons/hicolor/scalable/apps). É o único lugar que a bandeja do
# KDE resolve de forma confiável: um diretório avulso passado por
# set_icon_theme_path() registra certo no D-Bus, mas não é desenhado.
#
# Existe um arquivo POR COR, e não um arquivo por estado que é reescrito.
# Assim o nome do ícone é sempre estático: trocar de cor vira apontar para
# outro nome, e a bandeja nunca precisa reler um arquivo cujo conteúdo mudou
# — que é exatamente o caso em que o cache dela entrega o desenho antigo.
COLORS = {
    "blue":   "#3b9dff",
    "green":  "#2ecc71",
    "grey":   "#95a5a6",
    "white":  "#f2f6fa",
    "black":  "#1c1f24",
    "red":    "#e74c3c",
    "yellow": "#ffcc00",
}
DEFAULT_COLORS = {"update": "red", "idle": "green", "working": "grey"}


def icon_for(color):
    return f"update-arrow-{color}"

INTERVAL_MIN = 10                      # minutos entre checagens automáticas
KERNEL_RE = re.compile(r"^(kernel|akmod|kmod|.*nvidia)", re.I)


def run(cmd, timeout=600):
    """Executa e devolve (returncode, stdout). Nunca levanta exceção."""
    try:
        p = subprocess.run(
            cmd, shell=isinstance(cmd, str), capture_output=True,
            text=True, timeout=timeout,
        )
        return p.returncode, p.stdout
    except Exception as exc:                       # timeout, binário ausente...
        return 1, str(exc)


def load_colors():
    """Lê a escolha do usuário. Qualquer problema cai no padrão, porque um
    arquivo de configuração corrompido não pode impedir o ícone de aparecer."""
    colors = dict(DEFAULT_COLORS)
    try:
        with open(CONFIG) as fh:
            for line in fh:
                if "=" not in line or line.lstrip().startswith("#"):
                    continue
                key, val = (x.strip() for x in line.split("=", 1))
                if key in colors and val in COLORS:
                    colors[key] = val
    except OSError:
        pass
    return colors


def save_colors(colors):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG, "w") as fh:
        fh.write("# Cor do ícone da bandeja para cada estado.\n")
        fh.write("# Valores: " + ", ".join(sorted(COLORS)) + "\n")
        for key in ("update", "idle", "working"):
            fh.write(f"{key} = {colors[key]}\n")


class Tray:
    def __init__(self):
        Notify.init("Fedora Rawhide Updates")
        self.colors = load_colors()

        self.count = None          # None = ainda não sabemos
        self.critical = []         # pendentes de kernel/nvidia
        self.last_check = None
        self.busy = False

        self.ind = AppIndicator3.Indicator.new(
            APP_ID, icon_for(self.colors["working"]),
            AppIndicator3.IndicatorCategory.SYSTEM_SERVICES
        )
        self.ind.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.ind.set_title("Fedora Rawhide Updates")

        self.menu = Gtk.Menu()
        self.ind.set_menu(self.menu)
        self.build_menu()

        self.check(auto=True)
        GLib.timeout_add_seconds(INTERVAL_MIN * 60, self.on_timer)

    # ------------------------------------------------------------------ menu
    def build_menu(self):
        for child in self.menu.get_children():
            self.menu.remove(child)

        # Estado, em uma linha só, não clicável.
        if self.busy:
            label = "Checking…"
        elif self.count is None:
            label = "Status unknown"
        elif self.count == 0:
            label = "System is up to date"
        else:
            label = f"{self.count} update{'s' if self.count != 1 else ''} available"
        self.add_item(label, None, enabled=False, bold=True)

        # Kernel e nvidia merecem destaque: são o que obriga a reiniciar.
        if self.critical:
            self.add_item(f"includes {', '.join(self.critical[:3])}", None,
                          enabled=False)

        if self.last_check:
            self.add_item(f"Last checked {self.last_check}", None, enabled=False)

        self.menu.append(Gtk.SeparatorMenuItem())

        self.add_item("Check now", self.on_check_now, enabled=not self.busy)
        self.add_item("Install updates…", self.on_install,
                      enabled=bool(self.count) and not self.busy)
        self.add_item("Show package list", self.on_show_list,
                      enabled=bool(self.count) and not self.busy)

        self.menu.append(Gtk.SeparatorMenuItem())
        self.add_colors_menu()

        self.menu.append(Gtk.SeparatorMenuItem())

        startup = Gtk.CheckMenuItem(label="Start with system")
        startup.set_active(os.path.exists(AUTOSTART))
        startup.connect("toggled", self.on_startup_toggled)
        startup.show()
        self.menu.append(startup)

        self.menu.append(Gtk.SeparatorMenuItem())
        self.add_item("Quit", lambda *_: Gtk.main_quit())

        self.menu.show_all()

    def add_colors_menu(self):
        """Submenu "Colors", com um estado por linha e as cores em rádio.

        Rádio e não caixa: cada estado tem exatamente uma cor, e o grupo deixa
        isso explícito — o usuário vê qual está valendo sem precisar abrir e
        comparar.
        """
        root = Gtk.MenuItem(label="Colors")
        sub = Gtk.Menu()
        root.set_submenu(sub)

        for state, label in (("update", "Update available"),
                             ("idle", "Up to date"),
                             ("working", "Checking")):
            item = Gtk.MenuItem(label=f"{label}  ({self.colors[state]})")
            colmenu = Gtk.Menu()
            item.set_submenu(colmenu)

            group = []
            for color in sorted(COLORS):
                radio = Gtk.RadioMenuItem.new_with_label(group, color)
                group = radio.get_group()
                radio.set_active(self.colors[state] == color)
                radio.connect("toggled", self.on_color_chosen, state, color)
                radio.show()
                colmenu.append(radio)

            item.show_all()
            sub.append(item)

        root.show_all()
        self.menu.append(root)

    def on_color_chosen(self, item, state, color):
        # O toggled dispara também para o rádio que está sendo DESmarcado;
        # sem esta guarda a escolha seria sobrescrita pelo item antigo.
        if not item.get_active() or self.colors[state] == color:
            return
        self.colors[state] = color
        save_colors(self.colors)
        self.refresh_icon()
        self.build_menu()

    def refresh_icon(self):
        """Reaplica o ícone do estado atual, para a troca de cor valer na hora."""
        if self.busy:
            state = "working"
        elif self.count:
            state = "update"
        else:
            state = "idle"
        self.ind.set_icon_full(icon_for(self.colors[state]),
                               self.ind.get_title() or APP_ID)

    def add_item(self, label, cb, enabled=True, bold=False):
        item = Gtk.MenuItem()
        lbl = Gtk.Label()
        if bold:
            lbl.set_markup(f"<b>{GLib.markup_escape_text(label)}</b>")
        else:
            lbl.set_text(label)
        lbl.set_xalign(0.0)
        item.add(lbl)
        item.set_sensitive(enabled)
        if cb:
            item.connect("activate", cb)
        item.show_all()
        self.menu.append(item)
        return item

    # --------------------------------------------------------------- checagem
    def on_timer(self):
        self.check(auto=True)
        return True                                # mantém o timer vivo

    def on_check_now(self, *_):
        self.check(auto=False)

    def check(self, auto):
        if self.busy:
            return
        self.busy = True
        self.ind.set_icon_full(icon_for(self.colors["working"]), "Checking for updates")
        self.build_menu()
        threading.Thread(target=self._check_worker, args=(auto,),
                         daemon=True).start()

    def _check_worker(self, auto):
        # check-update devolve 100 quando HÁ atualizações e 0 quando não há;
        # qualquer outro código é erro de verdade.
        rc, out = run(["dnf", "check-update", "--refresh"], timeout=900)

        pkgs = []
        for line in out.splitlines():
            m = re.match(r"^([a-zA-Z0-9_.+-]+)\.(x86_64|i686|noarch)\s+\S+\s+\S+",
                         line)
            if m:
                pkgs.append(m.group(1))

        count = len(pkgs)
        critical = sorted({p for p in pkgs if KERNEL_RE.match(p)})
        GLib.idle_add(self._check_done, count, critical, pkgs, auto, rc)

    def _check_done(self, count, critical, pkgs, auto, rc):
        was = self.count
        self.count = count
        self.critical = critical
        self.pkgs = pkgs
        self.last_check = time.strftime("%H:%M")
        self.busy = False

        state = "update" if count else "idle"
        self.ind.set_icon_full(icon_for(self.colors[state]),
                               f"{count} updates" if count else "Up to date")
        self.build_menu()

        # Notifica só quando muda de "em dia" para "tem update", para não
        # incomodar a cada dez minutos.
        if count and was in (0, None) and auto:
            extra = ""
            if critical:
                extra = "\nIncludes kernel/driver — a reboot will be needed."
            self.notify(f"{count} updates available", extra.strip())
        return False

    def notify(self, title, body=""):
        try:
            n = Notify.Notification.new(title, body, icon_for(self.colors["update"]))
            n.show()
        except Exception:
            pass

    # ------------------------------------------------------------- instalação
    def on_install(self, *_):
        if self.busy:
            return
        self.busy = True
        self.ind.set_icon_full(icon_for(self.colors["working"]), "Installing updates")
        self.build_menu()
        threading.Thread(target=self._install_worker, daemon=True).start()

    def _install_worker(self):
        # Roda num terminal para o usuário ver o progresso e poder abortar.
        # pkexec cuida da autenticação.
        cmd = ("konsole --hold -e bash -c "
               + shlex.quote("pkexec dnf upgrade -y --refresh; echo; "
                             "echo '--- done, close this window ---'; read -n1"))
        rc, _ = run(cmd, timeout=7200)
        GLib.idle_add(self._install_done)

    def _install_done(self):
        self.busy = False
        self.check(auto=False)                     # revalida o estado real
        return False

    # ----------------------------------------------------------------- listas
    def on_show_list(self, *_):
        pkgs = getattr(self, "pkgs", [])
        if not pkgs:
            return
        text = "\n".join(sorted(pkgs))
        cmd = ("konsole --hold -e bash -c "
               + shlex.quote(f"printf '%s\\n' {shlex.quote(text)} | less"))
        subprocess.Popen(cmd, shell=True)

    # -------------------------------------------------------------- autostart
    def on_startup_toggled(self, item):
        if item.get_active():
            os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
            with open(AUTOSTART, "w") as fh:
                fh.write(
                    "[Desktop Entry]\n"
                    "Type=Application\n"
                    "Name=Fedora Rawhide Updates\n"
                    "Comment=Tray icon that watches for system updates\n"
                    f"Exec={SELF}\n"
                    "Icon=system-software-update\n"
                    "Terminal=false\n"
                    "X-GNOME-Autostart-enabled=true\n"
                )
        else:
            try:
                os.remove(AUTOSTART)
            except FileNotFoundError:
                pass


if __name__ == "__main__":
    Tray()
    Gtk.main()
